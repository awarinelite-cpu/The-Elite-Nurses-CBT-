# Firebase web app configuration (Firebase Console > Project settings)
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=

# Cloudinary: use a dedicated unsigned upload preset for browser uploads,
# or preferably implement signed uploads through a server endpoint.
PUBLIC_CLOUDINARY_CLOUD_NAME=
PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# Paystack secret keys must NEVER use a PUBLIC_ prefix.
PAYSTACK_SECRET_KEY=
PUBLIC_PAYSTACK_PUBLIC_KEY=
